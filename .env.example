# Google Analytics Service Account Configuration
# Download your service account JSON file from Google Cloud Console
# and set this path to point to that file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Alternative: Use the service account key directly as JSON string
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Server Configuration
PORT=3001

# Optional: Default property ID for testing
DEFAULT_PROPERTY_ID=123456789